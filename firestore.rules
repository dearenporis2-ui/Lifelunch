rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.progress is map
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Free-tier leaderboard entries are opt-in and must mirror the owner's save.
    match /leaderboard/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == entryId
        && exists(/databases/$(database)/documents/users/$(entryId))
        && get(/databases/$(database)/documents/users/$(entryId)).data.progress.leaderboardOptIn == true
        && request.resource.data.keys().hasAll(['name', 'avatar', 'xp', 'level', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'xp', 'level', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 24
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(entryId)).data.progress.name
        && request.resource.data.avatar == get(/databases/$(database)/documents/users/$(entryId)).data.progress.avatar
        && request.resource.data.xp is int
        && request.resource.data.xp == get(/databases/$(database)/documents/users/$(entryId)).data.progress.xp
        && request.resource.data.xp >= 0
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == entryId;
    }
  }
}
